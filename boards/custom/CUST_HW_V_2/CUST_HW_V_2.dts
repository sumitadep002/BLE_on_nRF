/dts-v1/;
#include <nordic/nrf52810_qfaa.dtsi>
#include "CUST_HW_V_2-pinctrl.dtsi"

/ {
	model = "Custom Board auto generated by nRF Connect for VS Code";
	compatible = "custom,CUST-HW-V-2";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console =  &uart0;
	};

	leds {
		compatible = "gpio-leds";
		red: red {
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			label = "red";
		};

		green: green {
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			label = "green";
		};

		blue: blue {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "blue";
		};
	};

	aliases {
		redled = &red;
		greenled = &green;
		blueled = &blue;
		upbutton = &upper;
		midbutton = &middle;
		lowbutton = &lower;
	};

	buttons {
		compatible = "gpio-keys";
		upper: upper {
			gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "upper";
		};
		middle: middle {
			gpios = <&gpio0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "middle";
		};
		lower: lower {
			gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "lower";
		};
	};
};

&gpio0 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
	disable-rx;
	compatible = "nordic,nrf-uart";
	current-speed = <115200>;
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 20)>;
		};
	};

};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(56)>;
		};

		slot1_partition: partition@1a000 {
			label = "image-1";
			reg = <0x0001a000 DT_SIZE_K(56)>;
		};

		storage_partition: partition@28000 {
			label = "storage";
			reg = <0x00028000 DT_SIZE_K(32)>;
		};

	};
};